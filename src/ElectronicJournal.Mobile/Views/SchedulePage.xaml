<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ElectronicJournal.Mobile.ViewModels"
             x:Class="ElectronicJournal.Mobile.Views.SchedulePage"
             x:DataType="vm:ScheduleViewModel"
             Title="Расписание"
             BackgroundColor="{StaticResource PageBackground}">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <ScrollView Padding="16">
            <VerticalStackLayout Spacing="12">

                <Label Text="Расписание на неделю" Style="{StaticResource PageTitle}" />

                <CollectionView ItemsSource="{Binding WeekDays}"
                                EmptyView="Расписание не загружено">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:Object">
                            <VerticalStackLayout Spacing="8" Margin="0,8">
                                <!-- Day header -->
                                <Frame BackgroundColor="{StaticResource Primary}" CornerRadius="12"
                                       HasShadow="False" BorderColor="Transparent" Padding="14,10">
                                    <Label Text="{Binding DayName}" TextColor="White"
                                           FontSize="17" FontAttributes="Bold" />
                                </Frame>

                                <!-- Lessons -->
                                <CollectionView ItemsSource="{Binding Lessons}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="x:Object">
                                            <Frame Style="{StaticResource CardFrame}" Margin="0,3">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                    <Frame Grid.Column="0" BackgroundColor="{StaticResource PrimaryLight}"
                                                           CornerRadius="10" Padding="10,6"
                                                           HasShadow="False" BorderColor="Transparent"
                                                           VerticalOptions="Center">
                                                        <Label Text="{Binding LessonNumber}" TextColor="White"
                                                               FontAttributes="Bold" FontSize="16" />
                                                    </Frame>
                                                    <VerticalStackLayout Grid.Column="1" Spacing="2"
                                                                         VerticalOptions="Center">
                                                        <Label Text="{Binding SubjectName}" FontSize="15"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource TextPrimary}" />
                                                        <Label Text="{Binding TeacherName}" FontSize="13"
                                                               TextColor="{StaticResource TextSecondary}" />
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="2" Spacing="2"
                                                                         VerticalOptions="Center"
                                                                         HorizontalOptions="End">
                                                        <Label Text="{Binding TimeRange}" FontSize="12"
                                                               TextColor="{StaticResource TextSecondary}"
                                                               HorizontalTextAlignment="End" />
                                                        <Label Text="{Binding Room, StringFormat='Каб. {0}'}"
                                                               FontSize="11" TextColor="{StaticResource Gray400}"
                                                               HorizontalTextAlignment="End" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </Frame>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   HorizontalOptions="Center" Margin="0,20" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
